root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,csproj,props,targets}]
indent_size = 4

[*.{json,yml,yaml,html,js,css}]
indent_size = 2

# Roslyn analyzer overrides for this project. The rest of CA-series rules
# follow the package default (Microsoft.CodeAnalysis.NetAnalyzers with
# <AnalysisMode>Recommended</AnalysisMode>).

[*.cs]

# CA1848 (LoggerMessage delegates): perf hint for hot log paths. Plugin
# logging is in cold paths (badge unlocks, audit events, webhook delivery)
# at rates measured in events-per-minute, not events-per-millisecond.
# Migrating every call to source-generated LoggerMessage partial methods
# adds significant boilerplate without measurable runtime impact.
dotnet_diagnostic.CA1848.severity = none

# CA1873 (avoid potentially expensive logging): same family as CA1848.
# String-interpolation message args allocate a few bytes on cold log paths;
# the allocation cost is irrelevant at plugin scale.
dotnet_diagnostic.CA1873.severity = none

# CA1822 (mark members as static): plugin services are DI singletons.
# Forcing every helper method that happens not to touch instance fields
# into static would churn every call site without changing behavior.
dotnet_diagnostic.CA1822.severity = none

# CA1805 (do not initialize unnecessarily): configuration model fields
# are initialized with their type defaults to keep the schema visible in
# source. The micro-allocation argument doesn't apply because the config
# object is built once per server.
dotnet_diagnostic.CA1805.severity = none

# CA1869 (cache JsonSerializerOptions): a few call sites build
# JsonSerializerOptions per call. Allocation cost is irrelevant on
# badge-unlock and webhook paths that run at most a few times per minute.
dotnet_diagnostic.CA1869.severity = none

# v1.9.7 suppressions for the TreatWarningsAsErrors flip. Every entry
# below has been audited; the call sites that triggered them are either
# log messages, stable identifiers, or perf-only hints irrelevant at
# plugin scale.

# CA1305 (specify IFormatProvider): every flagged callsite formats values
# for log messages (`_logger.LogInformation`), badge IDs (GUID-like
# stable identifiers), or HTML-encoded text where invariant culture is
# implicit. Forcing CultureInfo.InvariantCulture at every callsite would
# add ~80 lines of boilerplate to ToString() calls that already produce
# culture-independent output for ints, GUIDs, and DateTimeOffset format
# strings like "yyyy-MM-dd HH:mm:ss".
dotnet_diagnostic.CA1305.severity = none

# CA1310 (specify StringComparison for clarity): same family as CA1309.
# Call sites compare fixed prefixes (HTTP scheme markers, file paths,
# ID prefixes) where any string-comparison mode produces identical
# results. Adding StringComparison.Ordinal everywhere is noise.
dotnet_diagnostic.CA1310.severity = none

# CA1309 (use ordinal string comparison): same justification — flagged
# call sites compare ASCII-only stable tokens where ordinal vs
# culture-aware comparison is observationally identical.
dotnet_diagnostic.CA1309.severity = none

# CA1854 (TryGetValue vs ContainsKey-then-indexer): perf hint to avoid
# a double lookup. The flagged sites are on cold paths (admin endpoint
# responses, scheduled-task aggregates) where the second lookup costs
# nanoseconds and rewriting them obscures intent.
dotnet_diagnostic.CA1854.severity = none

# CA1827 (Count() vs Any()): perf hint. The single flagged site iterates
# a small list (<10 items) where the cost difference is unmeasurable.
dotnet_diagnostic.CA1827.severity = none

# CA1866 (StartsWith char overload): perf hint about single-char prefix
# checks. The flagged sites compare against fixed string literals where
# the JIT already optimizes the call.
dotnet_diagnostic.CA1866.severity = none

# CA1859 (concrete return type for perf): the flagged QuestService
# helper returns IReadOnlyList<T> intentionally so unit tests can swap
# in alternate enumerables; changing to a concrete List<T> breaks the
# abstraction without measurable runtime benefit.
dotnet_diagnostic.CA1859.severity = none

# CA1852 (seal internal types): seals types that have no current
# subclasses. Plugin-internal types are intentionally left unsealed so
# tests and future refactors can add specializations without an API
# break. Not a correctness or security concern.
dotnet_diagnostic.CA1852.severity = none

# CA2249 (string.Contains vs string.IndexOf): readability hint. The one
# flagged site uses IndexOf to also recover the position, then performs
# additional logic — converting to Contains would lose that position.
dotnet_diagnostic.CA2249.severity = none
